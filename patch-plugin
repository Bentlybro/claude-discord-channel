def server_ts() -> pathlib.Path:
    if "--file" in sys.argv:
        return pathlib.Path(sys.argv[sys.argv.index("--file") + 1])
    entries = json.loads(INSTALLED.read_text(encoding="utf-8"))["plugins"][PLUGIN]
    return pathlib.Path(entries[0]["installPath"]) / "server.ts"


def main() -> int:
    try:
        path = server_ts()
        src = path.read_text(encoding="utf-8")
    except Exception as exc:
        print(f"DISCORD PLUGIN PATCH: cannot find the installed plugin ({exc})")
        return 1
    missing = [p for p in PATCHES if p[1] not in src]
    if not missing:
        return 0
    if "--check" in sys.argv:
        for name, _, _ in missing:
            print(f"DISCORD PLUGIN PATCH missing in {path}: {name}")
        return 1
    for name, _, edits in missing:
        if any(src.count(old) != 1 for old, _ in edits):
            print(f"DISCORD PLUGIN PATCH cannot apply '{name}' to {path}: the code changed upstream. "
                  "Update patch-plugin; until then that behaviour is off.")
            return 1
        for old, new in edits:
            src = src.replace(old, new, 1)
    tmp = path.with_suffix(".ts.tmp")
    tmp.write_text(src, encoding="utf-8", newline="\n")
    tmp.replace(path)
    print(f"discord plugin patched ({', '.join(n for n, _, _ in missing)}): restart the agent to load it")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
